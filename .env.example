ENVIRONMENT=development

# Logfire
LOGFIRE_TOKEN=
LOGFIRE_ENVIRONMENT=development

# Bhashini API Key
MEITY_API_KEY_VALUE=

# Marqo
MARQO_ENDPOINT_URL=http://localhost:8882/
MARQO_INDEX_NAME=sunbird-va-index

# Redis
REDIS_HOST=redis-stack
REDIS_PORT=6379
REDIS_DB=0
# Set when the Redis cluster requires AUTH (shared platform Redis on demo/sandbox).
# Used by app/core/cache.py and app/core/limiter.py. Leave blank for password-less Redis.
REDIS_PASSWORD=

# Mapbox
MAPBOX_API_TOKEN=

# Beckn
BAP_ID=
BAP_URI=
BAP_ENDPOINT=
## BPPs
POCRA_BPP_ID=
POCRA_BPP_URI=
MAHADBT_BPP_ID=
MAHADBT_BPP_URI=

# Azure OpenAI (fallback model)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4.1

# vLLM / LLM endpoint (Qwen "agrinet-model")
LLM_PROVIDER=vllm
LLM_AGRINET_MODEL_NAME=agrinet-model
LLM_MODERATION_MODEL_NAME=agrinet-model
# OpenAI-compatible API *root*. Routes append /chat/completions; a full
# .../chat/completions URL is auto-trimmed back to the root (agents/models.py).
# Preferred (in-cluster, "as planned"): route via the ai4i orchestrate /
# inference-service, which exposes POST /api/v1/chat/completions:
#   VLLM_AGRINET_MODEL_URL=http://<inference-service>/api/v1
# Direct-vLLM fallback (DevOps demo workaround):
#   VLLM_AGRINET_MODEL_URL=http://65.2.186.224:8080/v1
VLLM_AGRINET_MODEL_URL=http://localhost:8080/v1
VLLM_MODERATION_MODEL_URL=http://localhost:8080/v1

# vLLM Concurrency Limits (optional, defaults shown)
VLLM_AGRINET_MAX_CONCURRENT=60
VLLM_MODERATION_MAX_CONCURRENT=100

# Model-compatibility toggles (defaults preserve full agrinet/Qwen behavior).
# Qwen "agrinet-model" has a 16k context; the system/agent prompt is ~12-13k
# tokens, so output must fit: max_output_tokens <= 16384 - actual_prompt_tokens.
# On the 16k Qwen demo deployment, AGRINET_MAX_TOKENS=4096 overflows (vLLM 400);
# either lower the output cap or trim the prompt via AGRINET_PROMPT_MAX_CHARS.
AGRINET_DISABLE_TOOLS=false
AGRINET_STREAMING_ENABLED=false
AGRINET_MAX_TOKENS=1024
AGRINET_PROMPT_MAX_CHARS=0
